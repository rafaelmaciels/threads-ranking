# ==============================================================================
# Threads Ranking — Environment Configuration
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provider Configuration: 'mock' | 'official' | 'external'
THREADS_PROVIDER=mock

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threads_ranking?schema=public

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Official Threads API (Meta for Developers) — Required if THREADS_PROVIDER=official
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/callback/threads

# External Provider (SocialFetch / EnsembleData) — Required if THREADS_PROVIDER=external
THREADS_EXTERNAL_API_URL=https://api.socialfetch.dev/v1
THREADS_EXTERNAL_API_KEY=

# Rate Limiting & Sync Settings
SYNC_INTERVAL_HOURS=6
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=60
